# Másold `secrets.yaml` néven, és töltsd ki. A secrets.yaml nincs verziókezelve
# (lásd .gitignore).
#
# Wi-Fi SSID/jelszó SZÁNDÉKOSAN nincs itt: az sosem kerül fordítási időben a
# firmware-be (lásd REQUIREMENTS.md "Hálózat és biztonság") - azt az első
# indításkor Bluetooth (BLE improv) vagy a Wi-Fi hotspot (AP + captive
# portal) adja meg, és az ESP a saját flash-ébe menti, nem ez a repó.
#
# Ami itt van, az mind eszköz-specifikus, fordítási idejű secret, aminek
# nincs futásidejű provisioning megfelelője az ESPHome-ban - ezek nem
# hálózati hitelesítők, nem szivárogtatnak semmit az otthoni hálózatról.

# ESPHome API titkosítási kulcs (esphome secrets.encryption_key generálja,
# vagy: openssl rand -base64 32)
api_encryption_key: "..."

ota_password: "..."

# Az ESP saját webes felületének (web_server) admin jelszava
web_server_password: "..."
